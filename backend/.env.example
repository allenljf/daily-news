# Server configuration only. Do not put real secrets in this file.
ALLOWED_USER_EMAIL=you@example.com
DATABASE_URL=postgresql+asyncpg://daily_news:change-me@localhost:5432/daily_news

# Ingestion Job adapter credentials. Set the real values only in Secret Manager.
# GOOGLE_CSE_API_KEY: API key for the Google Custom Search JSON API (Google Cloud Console).
GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID: Programmable Search Engine ID (https://programmablesearchengine.google.com).
GOOGLE_CSE_ID=
# GOOGLE_CSE_DATE_RESTRICT: optional recency window such as d7, w2, m1, y1. Defaults to m1.
GOOGLE_CSE_DATE_RESTRICT=
# YOUTUBE_API_KEY: YouTube Data API v3 key from Google Cloud Console.
YOUTUBE_API_KEY=
